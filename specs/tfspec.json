    "resources": [
        {
            "name": "nutanix_plugin_instance",
            "schema": {
                "attributes": [
                    {
                        "name": "alarms",
                        "single_nested": {
                            "computed_optional_required": "computed_optional",
                            "attributes": [
                                {
                                    "name": "critical",
                                    "int64": {
                                        "computed_optional_required": "computed_optional"
                                    }
                                },
                                {
                                    "name": "major",
                                    "int64": {
                                        "computed_optional_required": "computed_optional"
                                    }
                                },
                                {
                                    "name": "minor",
                                    "int64": {
                                        "computed_optional_required": "computed_optional"
                                    }
                                },
                                {
                                    "name": "warning",
                                    "int64": {
                                        "computed_optional_required": "computed_optional"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "api_version",
                        "string": {
                            "computed_optional_required": "computed_optional",
                            "default": {
                                "static": "nutanix.eda.nokia.com/v2"
                            },
                            "validators": [
                                {
                                    "custom": {
                                        "imports": [
                                            {
                                                "path": "regexp"
                                            },
                                            {
                                                "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                                            }
                                        ],
                                        "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^nutanix\\\\.eda\\\\.nokia\\\\.com/v2$\"), \"\")"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "deviations",
                        "single_nested": {
                            "computed_optional_required": "computed_optional",
                            "attributes": [
                                {
                                    "name": "count",
                                    "int64": {
                                        "computed_optional_required": "computed_optional"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "kind",
                        "string": {
                            "computed_optional_required": "computed_optional",
                            "default": {
                                "static": "NutanixPluginInstance"
                            },
                            "validators": [
                                {
                                    "custom": {
                                        "imports": [
                                            {
                                                "path": "regexp"
                                            },
                                            {
                                                "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                                            }
                                        ],
                                        "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^NutanixPluginInstance$\"), \"\")"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "metadata",
                        "single_nested": {
                            "computed_optional_required": "required",
                            "attributes": [
                                {
                                    "name": "annotations",
                                    "map": {
                                        "computed_optional_required": "computed_optional",
                                        "element_type": {
                                            "string": {}
                                        }
                                    }
                                },
                                {
                                    "name": "labels",
                                    "map": {
                                        "computed_optional_required": "computed_optional",
                                        "element_type": {
                                            "string": {}
                                        }
                                    }
                                },
                                {
                                    "name": "name",
                                    "string": {
                                        "computed_optional_required": "required",
                                        "validators": [
                                            {
                                                "custom": {
                                                    "imports": [
                                                        {
                                                            "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                                                        }
                                                    ],
                                                    "schema_definition": "stringvalidator.LengthAtMost(253)"
                                                }
                                            },
                                            {
                                                "custom": {
                                                    "imports": [
                                                        {
                                                            "path": "regexp"
                                                        },
                                                        {
                                                            "path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
                                                        }
                                                    ],
                                                    "schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$\"), \"\")"
                                                }
                                            }
                                        ]
                                    }
                                },
                                {
                                    "name": "namespace",
                                    "string": {
                                        "computed_optional_required": "computed_optional",
                                        "default": {
                                            "static": "eda-system"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "spec",
                        "single_nested": {
                            "computed_optional_required": "required",
                            "attributes": [
                                {
                                    "name": "auth_secret_ref",
                                    "string": {
                                        "computed_optional_required": "required",
                                        "description": "The name of a secret containing 'username' and 'password' keys to authenticate with Prism Central."
                                    }
                                },
                                {
                                    "name": "heartbeat_interval_seconds",
                                    "int64": {
                                        "computed_optional_required": "computed_optional",
                                        "default": {
                                            "static": 10
                                        },
                                        "description": "The time interval in seconds between successive heartbeats."
                                    }
                                },
                                {
                                    "name": "plugin_namespace",
                                    "string": {
                                        "computed_optional_required": "required",
                                        "description": "The namespace for the Plugin resources."
                                    }
                                },
                                {
                                    "name": "prism_central_certificate",
                                    "string": {
                                        "computed_optional_required": "optional",
                                        "description": "Optional certificate string to use to verify the server identity."
                                    }
                                },
                                {
                                    "name": "prism_central_host",
                                    "string": {
                                        "computed_optional_required": "required",
                                        "description": "The URL to the Nutanix Prism Central, with http(s) scheme."
                                    }
                                },
                                {
                                    "name": "prism_central_poll_interval_seconds",
                                    "int64": {
                                        "computed_optional_required": "computed_optional",
                                        "default": {
                                            "static": 2
                                        },
                                        "description": "The interval between polls to Prism Central for state changes, in seconds."
                                    }
                                },
                                {
                                    "name": "prism_central_tls_verify",
                                    "bool": {
                                        "computed_optional_required": "computed_optional",
                                        "default": {
                                            "static": true
                                        },
                                        "description": "Whether the client will verify the server's certificate."
                                    }
                                }
                            ],
                            "description": "NutanixPluginInstanceSpec defines the desired state of NutanixPluginInstance"
                        }
                    },
                    {
                        "name": "status",
                        "single_nested": {
                            "computed_optional_required": "computed_optional",
                            "description": "NutanixPluginInstanceStatus defines the observed state of NutanixPluginInstance"
                        }
                    },
                    {
                        "name": "name",
                        "string": {
                            "computed_optional_required": "computed_optional",
                            "description": "name of the NutanixPluginInstance"
                        }
                    }
                ]
            }
        }
    ],
    "version": "0.1"
